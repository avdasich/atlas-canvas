{
  "name": "atlas-canvas",
  "private": true,
  "version": "0.4.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node tests/run.mjs",
    "notices": "node scripts/build-notices.mjs",
    "format": "node scripts/organize-imports.mjs && prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "docs:shortcuts": "node scripts/build-shortcuts.mjs && prettier --write docs/SHORTCUTS.md docs/en/SHORTCUTS.md",
    "demo:check": "node scripts/check-demo.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "d3-geo": "^3.1.1",
    "konva": "^10.9.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-konva": "^19.3.2",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/d3-geo": "^3.1.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "license": "MIT"
}
